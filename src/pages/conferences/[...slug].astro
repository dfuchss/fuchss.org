---
import { readFileSync } from 'node:fs';
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Prose from '../../components/Prose.astro';
import CopyButton from '../../components/pub/CopyButton.astro';
import ScholarMeta from '../../components/pub/ScholarMeta.astro';
import VenueBadge from '../../components/pub/VenueBadge.astro';

export async function getStaticPaths() {
  const entries = await getCollection('conferences');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);

// reference() guarantees these resolve — a bad bib key or author id fails the build.
const pub = await getEntry(d.publication);
const authors = await Promise.all(d.authors.map((ref) => getEntry(ref)));

const LINK_LABELS: Record<string, string> = {
  ieee: 'IEEE Xplore',
  acm: 'ACM Digital Library',
  springer: 'SpringerLink',
  kitopen: 'KITopen',
  zenodo: 'Zenodo',
  repo: 'GitHub',
};

/*
 * Pull the diagram's intrinsic size out of its viewBox so the <img> carries
 * width/height. Without them the page reflows when the SVG loads — the audit
 * script flags exactly this.
 */
let figureSize: { width: number; height: number } | undefined;
if (d.figure) {
  const svg = readFileSync(`public${d.figure.src}`, 'utf8').slice(0, 2000);
  const vb = /viewBox="([\d.\s-]+)"/.exec(svg);
  if (vb) {
    const [, , w, h] = vb[1].trim().split(/\s+/).map(Number);
    if (w && h) figureSize = { width: Math.round(w), height: Math.round(h) };
  }
}

const bibId = `bib-${pub.id}`;
const paperLinks = Object.entries(d.links.paper ?? {});
const replLinks = Object.entries(d.links.replication ?? {});
const description = d.description ?? `${d.title} — published at ${d.conferenceName}.`;
---

<Base section="conferences" title={d.title} description={description}>
  <Fragment slot="head"><ScholarMeta pub={pub} /></Fragment>

  <article class="wrap section">
    <header>
      {
        /* The venue abbreviation is the shortest true name this page has — the
          collection carries no separate short label, and inventing one would
          mean a schema field per paper that repeats the badge. */
      }
      {
        /* One line doing both jobs: where you are, and what this is. A separate
          breadcrumb above a venue kicker said the same thing twice in a row,
          and the slug it ended on is the part a reader already knows — they
          just clicked it. So the path's leaf is the venue label instead.

          Both sides of the separator need an explicit space: Astro strips the
          newline between an element and the next, and it renders "publications/
          ICSE" without them. */
      }
      <p class="kicker" data-sigil="none">
        <a href="/publications/">publications</a>
        {' / '}
        {pub.data.abbr.id}
      </p>

      <h1>{d.title}</h1>

      <p class="byline">
        {
          authors.map((a, i) => (
            <>
              {i > 0 && (
                <span aria-hidden="true">{i === authors.length - 1 ? ', and ' : ', '}</span>
              )}
              <span class:list={['author', { self: a.id === 'dominik_fuchss' }]}>
                {a.data.name}
                {a.data.orcid && (
                  <a
                    class="orcid"
                    href={`https://orcid.org/${a.data.orcid}`}
                    rel="noopener"
                    aria-label={`ORCID record for ${a.data.name}`}
                    title={`ORCID ${a.data.orcid}`}
                  >
                    iD
                  </a>
                )}
              </span>
            </>
          ))
        }
      </p>

      {
        /* Badge and sentence on one line: the badge names the proceedings, the
          sentence names the event, and they are one fact, not two. The
          published/to-appear state is in the wording, so no status chip. */
      }
      <p class="venue-line">
        <VenueBadge abbr={pub.data.abbr.id} />
        <span>
          {d.alreadyPublished ? 'Published at the ' : 'To be published at the '}
          {
            d.conferenceUrl ? (
              <a href={d.conferenceUrl} rel="noopener">
                {d.conferenceName}
              </a>
            ) : (
              d.conferenceName
            )
          }
        </span>
      </p>

      <p class="actions">
        {
          pub.data.pdfUrl && (
            <a class="chip primary" href={pub.data.pdfUrl}>
              Read the PDF
            </a>
          )
        }
        {
          pub.data.doi && (
            <a class="chip" href={`https://doi.org/${pub.data.doi}`} rel="noopener">
              DOI
            </a>
          )
        }
      </p>
    </header>

    {
      d.figure && (
        <figure class:list={['approach', { plate: d.figure.plate }]}>
          <div class="frame">
            <div class="frame-bar" aria-hidden="true">
              <>
                <span class="dot" />
                <span class="dot" />
                <span class="dot" />
              </>
              {/* The figure's only visible label. `alt` is not repeated below it:
                it says the same thing, and a caption that restates the frame bar is
                noise for sighted readers and duplication for a screen reader. */}
              <span class="frame-label mono">approach overview</span>
            </div>
            <img
              src={d.figure.src}
              alt={d.figure.alt}
              width={figureSize?.width}
              height={figureSize?.height}
              loading="lazy"
              decoding="async"
            />
          </div>
        </figure>
      )
    }

    <Prose>
      <Content />
    </Prose>

    {
      (paperLinks.length > 0 || replLinks.length > 0) && (
        <section class="links">
          <h2>Links</h2>
          <div class="link-grid">
            {paperLinks.length > 0 && (
              <div>
                <h3 class="mono">paper</h3>
                <ul>
                  {paperLinks.map(([k, url]) => (
                    <li>
                      <a href={url} rel="noopener">
                        {LINK_LABELS[k] ?? k}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
            {replLinks.length > 0 && (
              <div>
                <h3 class="mono">replication package</h3>
                <ul>
                  {replLinks.map(([k, url]) => (
                    <li>
                      <a href={url} rel="noopener">
                        {LINK_LABELS[k] ?? k}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </section>
      )
    }

    {
      /* BibTeX alone. A full PubEntry here repeated the whole header — badge,
        title, authors, venue, PDF and DOI — a screen further down the same page,
        and buried the one thing this section is for behind a disclosure toggle. */
    }
    <section class="cite">
      <h2>Cite this paper</h2>
      <div class="bib-body">
        <CopyButton target={bibId} />
        <pre id={bibId}>{pub.data.bibtex}</pre>
      </div>
    </section>
  </article>
</Base>

<style>
  /* `.prose` is already `--measure`; these are the blocks that were not, and
     each one ending somewhere different is what made the column look ragged. */
  header,
  .approach,
  .links,
  .cite {
    max-width: var(--measure);
  }

  .kicker a {
    color: inherit;
  }
  .kicker a:hover {
    color: var(--sec-strong);
  }

  header {
    margin-bottom: 1.75rem;
  }

  /* Its own clamp rather than the global --fs-h1: a paper title is a sentence,
     not a page name, and at display size it becomes a wall four lines deep. */
  h1 {
    font-size: clamp(1.6rem, 1.1rem + 2.2vw, 2.5rem);
    margin-bottom: 0.75rem;
  }

  /* 1.8 because the ORCID badges sit above the baseline: at the default
     line-height they touch the names on the line above. */
  .byline {
    margin: 0 0 0.65rem;
    color: var(--text-muted);
    line-height: 1.8;
  }
  .author.self {
    color: var(--text);
    font-weight: 600;
  }
  .orcid {
    display: inline-block;
    margin-left: 0.35ch;
    padding: 0 0.3em;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    vertical-align: 0.15em;
    text-decoration: none;
    color: var(--sec);
    border: 1px solid var(--sec-line);
    border-radius: 3px;
  }
  .orcid:hover {
    background: var(--sec-dim);
  }

  .venue-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 0.5rem;
    color: var(--text-muted);
    font-size: var(--fs-small);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.1rem 0 0;
  }
  .chip.primary {
    border-color: var(--sec-line);
    background: var(--sec-dim);
    color: var(--sec-strong);
  }

  /* Browser-chrome frame: gives the light-background diagrams a surface to sit on. */
  .approach {
    margin: 2rem 0;
  }
  .frame {
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-m);
    overflow: hidden;
    background: var(--bg-2);
    box-shadow: 0 20px 45px -30px var(--sec-glow);
  }
  .frame-bar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.7rem;
    background: var(--bg-3);
    border-bottom: 1px solid var(--border);
  }
  .dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--border-strong);
  }
  .frame-label {
    margin-left: 0.5rem;
    color: var(--text-faint);
    font-size: 0.6875rem;
  }
  .approach img {
    display: block;
    width: 100%;
    margin: 0;
  }
  .approach.plate img {
    background: #fff;
    padding: 1rem;
  }
  .links,
  .cite {
    margin-top: 3rem;
  }
  .link-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 1.25rem;
  }
  .link-grid h3 {
    margin: 0 0 0.5rem;
    font-size: var(--fs-mono);
    color: var(--text-faint);
    text-transform: lowercase;
  }
  .link-grid ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.35rem;
  }
  .link-grid a {
    font-size: var(--fs-small);
  }

  /* Mirrors the BibTeX block in PubEntry: the copy button is absolutely
     positioned, so the block it copies has to be its containing block. */
  .bib-body {
    position: relative;
  }
  .bib-body pre {
    margin: 0;
    max-width: 100%;
    font-size: 0.75rem;
  }
</style>
