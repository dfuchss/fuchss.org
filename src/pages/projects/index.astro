---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/project/ProjectCard.astro';
import { getPage, fill, need } from '../../lib/pages.ts';

const { data } = await getPage('projects');

const projects = await getCollection('projects');
const groups = (await getCollection('projectGroups')).sort(
  (first, second) => first.data.order - second.data.order,
);

const grouped = groups.map((group) => ({
  id: group.id,
  ...group.data,
  items: projects
    .filter((project) => project.data.category.id === group.id)
    .sort(
      (first, second) =>
        first.data.order - second.data.order || first.data.title.localeCompare(second.data.title),
    ),
}));
---

<Base section="projects" title={data.title} description={data.description}>
  <section class="wrap section">
    <p class="kicker" data-sigil="##">
      projects
    </p>
    <h1>Projects</h1>
    <p class="lede">{fill(need(data.lede, 'projects.lede'), { count: projects.length })}</p>

    <nav class="jump mono" aria-label="Jump to category">
      {grouped.map((group) => (
        <a class="chip" href={`#${group.id}`}>
          {group.label.toLowerCase()} <span>{group.items.length}</span>
        </a>
      ))}
    </nav>

    {grouped.map((group) => (
      <section class="group" id={group.id}>
        <h2>{group.label}</h2>
        <p class="blurb">{group.blurb}</p>
        <ul class="grid">
          {group.items.map((project) => (
            <ProjectCard project={project} />
          ))}
        </ul>
      </section>
    ))}
  </section>
</Base>

<style>
  .lede {
    max-width: 62ch;
    color: var(--text-muted);
  }

  .group {
    margin-top: 3rem;
  }
  .group h2 {
    margin-bottom: 0.25rem;
  }
  .blurb {
    max-width: 60ch;
    color: var(--text-faint);
    font-size: var(--fs-small);
    margin-bottom: 1.25rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: 0.9rem;
    margin: 0;
    padding: 0;
  }
</style>
