---
import { getCollection, getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Prose from '../../components/Prose.astro';
import Lightbox from '../../components/Lightbox.astro';
import { fill, getPage, need } from '../../lib/pages.ts';
import { FORGE_ICONS } from '../../lib/icons.ts';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  // ardoco redirects to ardoco.de and has no page of its own.
  return projects
    .filter((project) => !project.data.redirect)
    .map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const projectData = project.data;
const { Content } = await render(project);
const { data: page } = await getPage('projects');

const source = projectData.source;

const category = await getEntry(projectData.category);
---

<Base section="projects" title={projectData.title} description={projectData.description}>
  <article class="wrap section">
    <p class="kicker" data-sigil="none">
      <a href="/projects/">projects</a> /{' '}
      <a href={`/projects/#${category.id}`}>{category.data.short.toLowerCase()}</a> / {project.id}
    </p>

    <header class="head">
      {projectData.logo && (
        // Rendered at 4.5rem; the 2x variant keeps it sharp on retina screens.
        <Image
          class="logo"
          src={projectData.logo}
          alt=""
          width={72}
          height={72}
          densities={[1, 2]}
        />
      )}
      <div>
        <h1>{projectData.title}</h1>
        <p class="desc">{projectData.description}</p>
        {/* Same action row as a paper page: the way to the code first, then facts. */}
        {(source || projectData.archived) && (
          <p class="actions">
            {source && (
              <a class="chip primary" href={source.url} rel="noopener">
                <svg
                  viewBox="0 0 24 24"
                  width="14"
                  height="14"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path d={FORGE_ICONS[source.host]} />
                </svg>
                {fill(need(page.sourceLabel, 'projects.sourceLabel'), { host: source.host })}
              </a>
            )}
            {source?.license && <span class="chip">{source.license}</span>}
            {projectData.archived && (
              <span class="chip">{need(page.archivedLabel, 'projects.archivedLabel')}</span>
            )}
          </p>
        )}
      </div>
    </header>

    <Prose>
      <Content />
    </Prose>
    <Lightbox label={need(page.imageDialogLabel, 'projects.imageDialogLabel')} />

    <p class="back mono">
      <a href="/projects/">{need(page.backLink, 'projects.backLink')}</a>
    </p>
  </article>
</Base>

<style>
  .kicker a {
    color: var(--text-faint);
  }
  .kicker a:hover {
    color: var(--sec);
  }

  /* Same reading column as `.prose`, so both rules line up with the text. */
  .head,
  .back {
    max-width: var(--measure);
  }
  .head {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }
  .logo {
    width: 4.5rem;
    height: 4.5rem;
    flex: none;
    object-fit: contain;
    border-radius: var(--radius-m);
    background: var(--bg-2);
    border: 1px solid var(--border);
    padding: 0.4rem;
  }
  h1 {
    margin-bottom: 0.25rem;
  }
  .desc {
    max-width: 60ch;
    color: var(--text-muted);
    margin: 0;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.1rem 0 0;
  }
  .chip.primary {
    gap: 0.6ch;
    border-color: var(--sec-line);
    background: var(--sec-dim);
    color: var(--sec-strong);
  }
  .chip svg {
    fill: currentColor;
  }

  .back {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .back a {
    color: var(--text-muted);
    text-decoration: none;
  }
  .back a:hover {
    color: var(--sec);
  }

  @media (max-width: 34rem) {
    .head {
      flex-direction: column;
      gap: 0.9rem;
    }
  }
</style>
