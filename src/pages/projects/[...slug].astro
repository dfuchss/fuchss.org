---
import { getCollection, getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Prose from '../../components/Prose.astro';
import { fill, getPage, need } from '../../lib/pages.ts';
import { FORGE_ICONS } from '../../lib/icons.ts';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  // ardoco redirects to ardoco.de and has no page of its own.
  return projects
    .filter((project) => !project.data.redirect)
    .map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const projectData = project.data;
const { Content } = await render(project);
const { data: page } = await getPage('projects');

const source = projectData.source;

const category = await getEntry(projectData.category);
---

<Base section="projects" title={projectData.title} description={projectData.description}>
  <article class="wrap section">
    <p class="kicker" data-sigil="none">
      <a href="/projects/">projects</a> /{' '}
      <a href={`/projects/#${category.id}`}>{category.data.short.toLowerCase()}</a> / {project.id}
    </p>

    <header class="head">
      {projectData.logo && (
        // Rendered at 4.5rem; the 2x variant keeps it sharp on retina screens.
        <Image
          class="logo"
          src={projectData.logo}
          alt=""
          width={72}
          height={72}
          densities={[1, 2]}
        />
      )}
      <div>
        <h1>{projectData.title}</h1>
        <p class="desc">{projectData.description}</p>
        {/* Same action row as a paper page: the way to the code first, then facts. */}
        {(source || projectData.archived) && (
          <p class="actions">
            {source && (
              <a class="chip primary" href={source.url} rel="noopener">
                <svg
                  viewBox="0 0 24 24"
                  width="14"
                  height="14"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path d={FORGE_ICONS[source.host]} />
                </svg>
                {fill(need(page.sourceLabel, 'projects.sourceLabel'), { host: source.host })}
              </a>
            )}
            {source?.license && <span class="chip">{source.license}</span>}
            {projectData.archived && (
              <span class="chip">{need(page.archivedLabel, 'projects.archivedLabel')}</span>
            )}
          </p>
        )}
      </div>
    </header>

    <Prose>
      <Content />
    </Prose>

    {/* Screenshots in the prose open enlarged here; wired up by the script below. */}
    <dialog class="lightbox" aria-label={need(page.imageDialogLabel, 'projects.imageDialogLabel')}>
      <img alt="" />
    </dialog>

    <p class="back mono">
      <a href="/projects/">{need(page.backLink, 'projects.backLink')}</a>
    </p>
  </article>
</Base>

<script>
  const lightbox = document.querySelector<HTMLDialogElement>('.lightbox');
  const enlarged = lightbox?.querySelector('img');
  // Images that already link somewhere (the before/after pairs) keep their link.
  const screenshots = document.querySelectorAll<HTMLImageElement>('.prose img:not(a img)');

  if (lightbox && enlarged) {
    screenshots.forEach((screenshot) => {
      // The alt text becomes the button's accessible name.
      screenshot.setAttribute('role', 'button');
      screenshot.tabIndex = 0;
      screenshot.classList.add('zoomable');

      const open = () => {
        enlarged.src = screenshot.currentSrc || screenshot.src;
        enlarged.alt = screenshot.alt;
        lightbox.showModal();
      };
      screenshot.addEventListener('click', open);
      screenshot.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          open();
        }
      });
    });

    // The image and the backdrop both sit inside the dialog box, so any click
    // closes it. Escape and focus return to the screenshot come from showModal().
    lightbox.addEventListener('click', () => lightbox.close());
  }
</script>

<style>
  .kicker a {
    color: var(--text-faint);
  }
  .kicker a:hover {
    color: var(--sec);
  }

  /* Same reading column as `.prose`, so both rules line up with the text. */
  .head,
  .back {
    max-width: var(--measure);
  }
  .head {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }
  .logo {
    width: 4.5rem;
    height: 4.5rem;
    flex: none;
    object-fit: contain;
    border-radius: var(--radius-m);
    background: var(--bg-2);
    border: 1px solid var(--border);
    padding: 0.4rem;
  }
  h1 {
    margin-bottom: 0.25rem;
  }
  .desc {
    max-width: 60ch;
    color: var(--text-muted);
    margin: 0;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.1rem 0 0;
  }
  .chip.primary {
    gap: 0.6ch;
    border-color: var(--sec-line);
    background: var(--sec-dim);
    color: var(--sec-strong);
  }
  .chip svg {
    fill: currentColor;
  }

  /* Screenshots live in the prose, which remark renders outside this component. */
  :global(.prose img.zoomable) {
    cursor: zoom-in;
  }
  :global(.prose img.zoomable:focus-visible) {
    outline: 2px solid var(--sec);
    outline-offset: 3px;
  }

  .lightbox {
    max-width: none;
    max-height: none;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 1.5rem;
    border: 0;
    background: transparent;
    cursor: zoom-out;
  }
  .lightbox[open] {
    display: grid;
    place-items: center;
  }
  .lightbox::backdrop {
    background: color-mix(in srgb, var(--bg) 88%, transparent);
  }
  .lightbox img {
    max-width: 100%;
    max-height: 100%;
    border-radius: var(--radius-m);
    background: var(--bg-2);
    box-shadow: 0 18px 60px rgb(0 0 0 / 60%);
  }

  .back {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .back a {
    color: var(--text-muted);
    text-decoration: none;
  }
  .back a:hover {
    color: var(--sec);
  }

  @media (max-width: 34rem) {
    .head {
      flex-direction: column;
      gap: 0.9rem;
    }
  }
</style>
