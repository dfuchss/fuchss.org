---
import Base from '../../../layouts/Base.astro';
import {
  publishedPosts,
  groupByTag,
  slugifyTag,
  permalink,
  formatPostDate,
} from '../../../lib/blog.ts';
import { getPage, fill, pluralize, need } from '../../../lib/pages.ts';

export async function getStaticPaths() {
  const posts = await publishedPosts();
  return groupByTag(posts).map(([tag, items]) => ({
    params: { tag: slugifyTag(tag) },
    props: { tag, items },
  }));
}

const { tag, items } = Astro.props;
const { data } = await getPage('blog');
---

<Base
  section="blog"
  title={fill(need(data.tagTitle, 'blog.tagTitle'), { tag })}
  description={fill(need(data.tagDescription, 'blog.tagDescription'), { tag })}
>
  <section class="wrap section">
    <p class="kicker" data-sigil="none">
      <a href="/blog/">blog</a> / tag
    </p>
    <h1>{tag}</h1>
    <p class="lede">{pluralize(need(data.tagCount, 'blog.tagCount'), items.length)}</p>

    <ol class="posts">
      {items.map((post) => (
        <li>
          <a href={permalink(post.id)}>
            <time class="mono" datetime={post.data.date.toISOString().slice(0, 10)}>
              {formatPostDate(post.data.date)}
            </time>
            <span>{post.data.title}</span>
          </a>
        </li>
      ))}
    </ol>
    <p class="back mono">
      <a href="/blog/">{data.backLink}</a>
    </p>
  </section>
</Base>

<style>
  .kicker a {
    color: var(--text-faint);
  }
  .lede {
    color: var(--text-muted);
  }
  .posts {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
  }
  .posts a {
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: 0 1.25rem;
    padding: 0.7rem 0.5rem;
    border-top: 1px solid var(--border);
    text-decoration: none;
    color: inherit;
    border-radius: var(--radius-s);
  }
  .posts a:hover {
    background: var(--sec-dim);
    color: var(--sec-strong);
  }
  .posts time {
    color: var(--text-faint);
  }
  .back {
    margin-top: 2rem;
  }
  .back a {
    color: var(--text-muted);
    text-decoration: none;
  }
  @media (max-width: 38rem) {
    .posts a {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
  }
</style>
