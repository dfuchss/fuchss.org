---
import Base from '../layouts/Base.astro';
import Email from '../components/Email.astro';
import { getPage, need } from '../lib/pages.ts';
import { cv } from '../lib/cv.ts';

const { data, Content } = await getPage('impressum');
const email = need(data.email, 'impressum.email');
---

<Base title={data.title} description={data.description}>
  <section class="wrap section">
    <p class="kicker" data-sigil="none">
      {data.kicker}
    </p>
    <h1>Impressum</h1>

    <div class="contact card">
      <h2 class="mono">Kontakt</h2>
      <p>{cv.name}</p>
      <p>
        E-Mail: <Email address={email} />
      </p>
    </div>

    <div class="legal">
      <Content />
    </div>
  </section>
</Base>

<style>
  .contact {
    margin: 0 0 2.5rem;
    max-width: 30rem;
  }
  .contact h2 {
    margin: 0 0 0.6rem;
    font-size: var(--fs-mono);
    color: var(--text-faint);
    text-transform: lowercase;
  }
  .contact p {
    margin: 0 0 0.25rem;
  }

  /* The legal text is Markdown, so its elements are not scoped to this page. */
  .legal {
    max-width: 72ch;
  }
  .legal :global(h3) {
    font-size: 1rem;
    color: var(--sec-strong);
    margin-bottom: 0.4rem;
  }
  .legal :global(p) {
    font-size: var(--fs-small);
    color: var(--text-muted);
    margin: 0 0 1.75rem;
  }

  .legal :global(.credit) {
    margin: 2.5rem 0 1em;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
    font-size: 0.75rem;
    color: var(--text-faint);
    max-width: 72ch;
  }
</style>
