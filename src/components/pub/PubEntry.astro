---
import type { CollectionEntry } from 'astro:content';
import VenueBadge from './VenueBadge.astro';
import CopyButton from './CopyButton.astro';
import BibMark from '../BibMark.astro';
import DoiMark from '../DoiMark.astro';
import PdfMark from '../PdfMark.astro';
import ScholarMark from '../ScholarMark.astro';
import { citationsFor, scholarPaperUrl } from '../../lib/citations.ts';
import { truncateAuthors, fullName, isSelf } from '../../lib/authors.ts';
import { getPage, fill, pluralize, need } from '../../lib/pages.ts';

interface Props {
  publication: CollectionEntry<'publications'>;
  /** Slug of the conference paper page for this publication, when one exists. */
  paperPage?: string;
  /**
   * Trim the entry to its citation. BibTeX belongs on /publications/, where
   * people go to collect citations.
   */
  compact?: boolean;
}
const { publication, paperPage, compact = false } = Astro.props;
const paper = publication.data;
const { data: copy } = await getPage('site/publication');

const { shown, hidden } = truncateAuthors(paper.authors);
const citationCount = citationsFor(paper.googleScholarId);
const scholarUrl = scholarPaperUrl(paper.googleScholarId);
const Cites = scholarUrl ? 'a' : 'span';

// Where it appeared: proceedings, journal, or the awarding institution.
const inParts = [
  paper.booktitle ?? paper.journal ?? paper.school ?? paper.institution,
  paper.location,
].filter(Boolean);
const bibId = `bib-${publication.id}`;
---

<li class="entry reveal" id={publication.id}>
  <div class="badge">
    <VenueBadge abbr={paper.abbr.id} />
  </div>

  <div class="body">
    <h3 class="title">
      {paperPage ? (
        <a class="title-link" href={`/conferences/${paperPage}/`}>
          {paper.title}
          <span class="sr-only"> ({need(copy.hasPage, 'publication.hasPage')})</span>
        </a>
      ) : (
        paper.title
      )}
      <span class="title-icons">
        {paper.pdfUrl && (
          <a
            class="title-icon"
            href={paper.pdfUrl}
            title={copy.pdf}
            aria-label={`${copy.pdf}: ${paper.title}`}
          >
            <PdfMark />
          </a>
        )}
        {paper.doi && (
          <a
            class="title-icon"
            href={`https://doi.org/${paper.doi}`}
            rel="noopener"
            title={copy.doi}
            aria-label={`${copy.doi}: ${paper.title}`}
          >
            <DoiMark />
          </a>
        )}
        {!compact && (
          <button
            class="title-icon bib-toggle"
            type="button"
            aria-expanded="false"
            aria-controls={bibId}
            aria-label={`BibTeX: ${paper.title}`}
            title={copy.bibtex}
            hidden
          >
            <BibMark />
          </button>
        )}
        {citationCount > 0 && (
          <Cites
            class="title-icon cites"
            title="Citations according to Google Scholar"
            {...(scholarUrl ? { href: scholarUrl, rel: 'noopener' } : {})}
          >
            <ScholarMark />
            <span class="count mono" aria-hidden="true">
              {citationCount}
            </span>
            <span class="sr-only">
              {pluralize(need(copy.citations, 'publication.citations'), citationCount)} on Google
              Scholar
            </span>
          </Cites>
        )}
      </span>
    </h3>

    <p class="authors">
      {shown.map((author, index) => (
        <>
          {index > 0 && <span aria-hidden="true">, </span>}
          {isSelf(author) ? <strong>{fullName(author)}</strong> : <span>{fullName(author)}</span>}
        </>
      ))}
      {hidden > 0 && (
        <span class="more">
          {' '}
          {fill(need(copy.moreAuthors, 'publication.moreAuthors'), { count: hidden })}
        </span>
      )}
    </p>

    {inParts.length > 0 && (
      <p class="venue-line">
        <em>{inParts.join(', ')}</em>
        {paper.year ? <span>, {paper.year}</span> : null}
      </p>
    )}

    {!compact && (
      <div class="bib-body" id={bibId}>
        <CopyButton target={`${bibId}-text`} />
        <pre id={`${bibId}-text`}>{paper.bibtex}</pre>
      </div>
    )}
  </div>
</li>

<script>
  // Without JS the BibTeX stays open and the button stays hidden.
  for (const btn of document.querySelectorAll<HTMLButtonElement>('button.bib-toggle')) {
    const panel = document.getElementById(btn.getAttribute('aria-controls')!);
    if (!panel) continue;
    panel.hidden = true;
    btn.hidden = false;
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') !== 'true';
      btn.setAttribute('aria-expanded', String(open));
      panel.hidden = !open;
    });
  }
</script>

<style>
  .entry {
    display: grid;
    /* minmax(0, 1fr) rather than 1fr: a plain `1fr` track has `min-width: auto`,
       so the wide BibTeX block would stretch the column past the viewport. */
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: 0 1.1rem;
    padding: 1.1rem 0;
    border-top: 1px solid var(--border);
  }
  .entry:target {
    background: var(--sec-dim);
    border-radius: var(--radius-m);
    padding-inline: 0.75rem;
  }

  .badge {
    padding-top: 0.2rem;
  }

  .title {
    font-size: 1.0625rem;
    font-weight: 600;
    margin: 0 0 0.2rem;
    line-height: 1.35;
  }

  .authors,
  .venue-line {
    margin: 0 0 0.3rem;
    font-size: var(--fs-small);
    color: var(--text-muted);
  }
  .authors strong {
    color: var(--text);
  }
  .more {
    color: var(--text-faint);
    font-style: italic;
  }
  .venue-line em {
    color: var(--text-muted);
  }

  /* Underlined at rest: the one cue that a title leads to a page of ours. */
  .title-link {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-decoration-color: color-mix(in srgb, var(--sec) 70%, transparent);
    text-decoration-skip-ink: auto;
    text-underline-offset: 0.18em;
  }
  .title-link:hover {
    color: var(--sec-strong);
    text-decoration-color: var(--sec-strong);
    text-decoration-thickness: 2.5px;
  }

  /* Beside the title, not inside its link, so the underline stops at the text.
     The group does not break, so the icons never split across lines. */
  .title-icons {
    white-space: nowrap;
  }
  .title-icon {
    display: inline-flex;
    align-items: center;
    gap: 0.25em;
    margin-inline-start: 0.4em;
    vertical-align: -0.1em;
    transition:
      translate var(--dur) var(--ease),
      filter var(--dur) var(--ease);
  }
  a.title-icon:hover,
  a.title-icon:focus-visible,
  button.title-icon:hover,
  button.title-icon:focus-visible {
    translate: 0 -1px;
    filter: brightness(1.12);
  }
  /* The BibTeX control is a button: strip the UA chrome. */
  .bib-toggle {
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }
  .title-icon[hidden] {
    display: none;
  }
  .bib-toggle[aria-expanded='true'] {
    filter: brightness(1.25);
  }
  .link-icon {
    color: var(--text-muted);
  }
  /* Scholar blue, lifted for the dark theme; the mark itself is currentColor. */
  .cites {
    color: #5b9bff;
    text-decoration: none;
  }
  .count {
    font-size: 0.78rem;
    line-height: 1;
    color: #a9c7ff;
  }

  /* Copy sits in the corner of the block it copies, rather than floating above
     it. The block gets room on the right so long lines never run underneath. */
  .bib-body {
    position: relative;
    margin-top: 0.5rem;
  }
  .bib-body pre {
    margin: 0;
    max-width: 100%;
    font-size: 0.75rem;
  }
  /* Overlays the code rather than reserving a gutter: reserving one via
     padding pushed the block past its flex basis and off the screen. The solid
     background and shadow keep it readable over whatever it covers. */
  @media (max-width: 34rem) {
    .entry {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }
</style>
