---
import type { CollectionEntry } from 'astro:content';
import VenueBadge from './VenueBadge.astro';
import CopyButton from './CopyButton.astro';
import { citationsFor } from '../../lib/citations.ts';
import { truncateAuthors, fullName, isSelf } from '../../lib/authors.ts';
import { getPage, fill, pluralize, need } from '../../lib/pages.ts';

interface Props {
  publication: CollectionEntry<'publications'>;
  /** Slug of the conference paper page for this publication, when one exists. */
  paperPage?: string;
  /**
   * Trim the entry to its citation. The home page links the paper page from the
   * title, so the "Paper page" chip would be a second copy of that link, and
   * BibTeX belongs on /publications/ where people go to collect citations.
   */
  compact?: boolean;
}
const { publication, paperPage, compact = false } = Astro.props;
const paper = publication.data;
const { data: copy } = await getPage('site/publication');

const { shown, hidden } = truncateAuthors(paper.authors);
const citationCount = citationsFor(paper.googleScholarId);

// Where it appeared: proceedings, journal, or the awarding institution.
const inParts = [
  paper.booktitle ?? paper.journal ?? paper.school ?? paper.institution,
  paper.location,
].filter(Boolean);
const bibId = `bib-${publication.id}`;
---

<li class="entry reveal" id={publication.id}>
  <div class="badge">
    <VenueBadge abbr={paper.abbr.id} />
  </div>

  <div class="body">
    <h3 class="title">
      {paperPage ? (
        <a class="title-link" href={`/conferences/${paperPage}/`}>
          {paper.title}
        </a>
      ) : (
        paper.title
      )}
    </h3>

    <p class="authors">
      {shown.map((author, index) => (
        <>
          {index > 0 && <span aria-hidden="true">, </span>}
          {isSelf(author) ? <strong>{fullName(author)}</strong> : <span>{fullName(author)}</span>}
        </>
      ))}
      {hidden > 0 && (
        <span class="more">
          {' '}
          {fill(need(copy.moreAuthors, 'publication.moreAuthors'), { count: hidden })}
        </span>
      )}
    </p>

    {inParts.length > 0 && (
      <p class="venue-line">
        <em>{inParts.join(', ')}</em>
        {paper.year ? <span>, {paper.year}</span> : null}
      </p>
    )}

    <div class="links">
      {paper.pdfUrl && (
        <a class="chip" href={paper.pdfUrl}>
          {copy.pdf}
        </a>
      )}
      {paper.doi && (
        <a class="chip" href={`https://doi.org/${paper.doi}`} rel="noopener">
          {copy.doi}
        </a>
      )}
      {citationCount > 0 && (
        <span class="chip cites" title="Citations (Google Scholar)">
          {pluralize(need(copy.citations, 'publication.citations'), citationCount)}
        </span>
      )}
      {paperPage && !compact && (
        <a class="chip paper-page" href={`/conferences/${paperPage}/`}>
          {copy.paperPage}
        </a>
      )}
      {!compact && (
        <details class="bib">
          <summary class="chip bib-toggle">
            <span class="caret mono" aria-hidden="true">
              ▸
            </span>
            {copy.bibtex}
          </summary>
          <div class="bib-body">
            <CopyButton target={bibId} />
            <pre id={bibId}>{paper.bibtex}</pre>
          </div>
        </details>
      )}
    </div>
  </div>
</li>

<style>
  .entry {
    display: grid;
    /* minmax(0, 1fr) rather than 1fr: a plain `1fr` track has `min-width: auto`,
       so the wide BibTeX block would stretch the column past the viewport. */
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: 0 1.1rem;
    padding: 1.1rem 0;
    border-top: 1px solid var(--border);
  }
  .entry:target {
    background: var(--sec-dim);
    border-radius: var(--radius-m);
    padding-inline: 0.75rem;
  }

  .badge {
    padding-top: 0.2rem;
  }

  .title {
    font-size: 1.0625rem;
    font-weight: 600;
    margin: 0 0 0.2rem;
    line-height: 1.35;
  }

  .authors,
  .venue-line {
    margin: 0 0 0.3rem;
    font-size: var(--fs-small);
    color: var(--text-muted);
  }
  .authors strong {
    color: var(--text);
  }
  .more {
    color: var(--text-faint);
    font-style: italic;
  }
  .venue-line em {
    color: var(--text-muted);
  }

  /* Inline layout, not flex. The chips are inline-flex so they wrap on their
     own, and the BibTeX block — a block-level child — starts its own line and
     sizes to this container. As a flex item it instead resolved its width from
     the `pre` and its padding, ending up wider than the column. */
  .links {
    margin: 0.5rem 0 0;
  }
  .links > .chip,
  .links .bib-toggle {
    margin: 0 0.4rem 0.4rem 0;
    vertical-align: middle;
  }
  .cites {
    border-color: var(--sec-line);
    color: var(--sec);
    background: var(--sec-dim);
  }
  /* The one link here that leads to a page of ours rather than off-site. */
  .title-link {
    color: inherit;
    text-decoration: none;
  }
  .title-link:hover {
    color: var(--sec-strong);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .paper-page {
    border-color: var(--sec-line);
    color: var(--sec-strong);
  }

  /* `display: contents` promotes the summary and the body to flex items of the
     pill row, so the chip keeps its place in the row and never moves when you
     open it — the body just wraps onto a full-width line beneath.
     It also bypasses the UA's own hiding of closed content, so hide it here. */
  .bib {
    display: contents;
  }
  .bib:not([open]) .bib-body {
    display: none;
  }
  /* Reads as one more chip in the row above, so it is obviously a control.
     The default disclosure triangle is replaced by a caret we can animate. */
  .bib-toggle {
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  .bib-toggle::-webkit-details-marker {
    display: none;
  }
  .bib-toggle:hover {
    border-color: var(--sec-line);
    color: var(--sec-strong);
  }
  .caret {
    display: inline-block;
    font-size: 0.7em;
    transition: rotate var(--dur) var(--ease);
  }
  .bib[open] .caret {
    rotate: 90deg;
  }

  /* Copy sits in the corner of the block it copies, rather than floating above
     it. The block gets room on the right so long lines never run underneath. */
  .bib-body {
    position: relative;
    margin-top: 0.1rem;
  }
  .bib-body pre {
    margin: 0;
    max-width: 100%;
    font-size: 0.75rem;
  }
  /* Overlays the code rather than reserving a gutter: reserving one via
     padding pushed the block past its flex basis and off the screen. The solid
     background and shadow keep it readable over whatever it covers. */
  @media (max-width: 34rem) {
    .entry {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }
</style>
