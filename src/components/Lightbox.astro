---
// Opens images in the rendered prose enlarged. Place once per page, after <Prose>.
interface Props {
  // Accessible name of the dialog.
  label: string;
}

const { label } = Astro.props;
---

<dialog class="lightbox" aria-label={label}>
  <img alt="" />
</dialog>

<script>
  const lightbox = document.querySelector<HTMLDialogElement>('.lightbox');
  const enlarged = lightbox?.querySelector('img');
  const screenshots = document.querySelectorAll<HTMLImageElement>('.prose img');

  if (lightbox && enlarged) {
    screenshots.forEach((screenshot) => {
      const link = screenshot.closest('a');

      // A link to the image's own file (the before/after pairs) opens here
      // instead; without JavaScript it still leads to the file. Links anywhere
      // else keep their target.
      if (link) {
        if (link.href !== screenshot.src) return;
        screenshot.classList.add('zoomable');
        link.addEventListener('click', (event) => {
          // Modified clicks still open the file in a new tab or window.
          if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
          event.preventDefault();
          enlarged.src = link.href;
          enlarged.alt = screenshot.alt;
          lightbox.showModal();
        });
        return;
      }

      // The alt text becomes the button's accessible name.
      screenshot.setAttribute('role', 'button');
      screenshot.tabIndex = 0;
      screenshot.classList.add('zoomable');

      const open = () => {
        enlarged.src = screenshot.currentSrc || screenshot.src;
        enlarged.alt = screenshot.alt;
        lightbox.showModal();
      };
      screenshot.addEventListener('click', open);
      screenshot.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          open();
        }
      });
    });

    // The image and the backdrop both sit inside the dialog box, so any click
    // closes it. Escape and focus return to the screenshot come from showModal().
    lightbox.addEventListener('click', () => lightbox.close());
  }
</script>

<style>
  /* Screenshots live in the prose, which remark renders outside this component. */
  :global(.prose img.zoomable) {
    cursor: zoom-in;
  }
  :global(.prose img.zoomable:focus-visible) {
    outline: 2px solid var(--sec);
    outline-offset: 3px;
  }

  .lightbox {
    max-width: none;
    max-height: none;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 1.5rem;
    border: 0;
    background: transparent;
    cursor: zoom-out;
  }
  .lightbox[open] {
    display: grid;
    place-items: center;
  }
  .lightbox::backdrop {
    background: color-mix(in srgb, var(--bg) 88%, transparent);
  }
  .lightbox img {
    max-width: 100%;
    max-height: 100%;
    border-radius: var(--radius-m);
    background: var(--bg-2);
    box-shadow: 0 18px 60px rgb(0 0 0 / 60%);
  }
</style>
