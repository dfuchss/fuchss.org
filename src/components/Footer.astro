---
import { getPage } from '../lib/pages.ts';
import { cv } from '../lib/cv.ts';

// Profile links live on the home page (see SocialRow), including the rel="me"
// identity verification — repeating them on every page added nothing.
// Text lives in src/content/pages/site/footer.md.
const { data } = await getPage('site/footer');
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap">
    <p class="meta mono">
      <span>
        © {year} {cv.name}
      </span>
      {(data.links ?? []).map((link) => (
        <>
          <span aria-hidden="true">·</span>
          <a href={link.href}>{link.label}</a>
        </>
      ))}
      <span aria-hidden="true">·</span>
      <span>
        built with <a href="https://astro.build/">Astro</a> and{' '}
        <a href="https://github.com/dfuchss/astro-studia">Studia Theme</a>
      </span>
    </p>
  </div>
</footer>

<style>
  .footer {
    margin-top: clamp(3rem, 8vw, 6rem);
    border-top: 1px solid var(--border);
    padding-block: 2rem 3rem;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5ch;
    align-items: center;
    color: var(--text-faint);
    margin: 0;
  }
  .meta a {
    color: var(--text-muted);
    text-decoration: none;
  }
  .meta a:hover {
    color: var(--sec-strong);
  }
</style>
